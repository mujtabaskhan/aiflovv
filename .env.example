# ─────────────────────────────────────────────────────────────────────────────
# Contact form email delivery. Copy this file to .env.local (or set the same
# variables in your hosting dashboard) and fill in ONE provider.
# ─────────────────────────────────────────────────────────────────────────────

# Option A — SMTP (Google Workspace/Gmail, Microsoft 365, Zoho, cPanel mail…)
# Gmail / Workspace: turn on 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@aiflovv.com
SMTP_PASS=your-16-character-app-password

# Option B — Resend (https://resend.com). Verify the aiflovv.com domain there,
# create an API key, and use it instead of the SMTP settings above.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where briefs are delivered, and the address they're sent from. The "from"
# address must be one your provider allows you to send as.
CONTACT_TO=info@aiflovv.com
CONTACT_FROM="AiFlovv Website <info@aiflovv.com>"

# Optional: also email the visitor a short "we've received your brief" note.
CONTACT_ACK=false
